FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    APP_MODE=resource-offer

WORKDIR /app

COPY requirements-resource-offer.txt /app/requirements-resource-offer.txt
RUN python -m pip install --upgrade pip && \
    pip install -r /app/requirements-resource-offer.txt

COPY src /app/src
COPY resource_offer_api.py /app/resource_offer_api.py
COPY emulated_usage_api.py /app/emulated_usage_api.py
COPY docker/entrypoint-resource-offer.sh /app/entrypoint.sh

RUN chmod +x /app/entrypoint.sh && \
    useradd --create-home --shell /usr/sbin/nologin appuser

USER appuser

EXPOSE 8080 8090

ENTRYPOINT ["/app/entrypoint.sh"]
